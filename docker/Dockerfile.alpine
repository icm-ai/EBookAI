# EBookAI开发环境 (Alpine Linux - 本地构建)
FROM node:22-alpine

# 安装系统依赖
RUN apk add --no-cache \
    python3 \
    py3-pip \
    python3-dev \
    git \
    build-base \
    libffi-dev \
    openssl-dev \
    curl \
    bash \
    tesseract-ocr \
    tesseract-ocr-dev \
    leptonica-dev \
    tesseract-ocr-data-chi_sim \
    tesseract-ocr-data-chi_tra \
    tesseract-ocr-data-eng \
    poppler-utils \
    libreoffice \
    gcc \
    g++ \
    musl-dev \
    linux-headers \
    jpeg-dev \
    zlib-dev \
    freetype-dev \
    lcms2-dev \
    openjpeg-dev \
    tiff-dev \
    tk-dev \
    tcl-dev \
    harfbuzz-dev \
    fribidi-dev \
    jbig2dec-dev \
    mupdf-dev

# 创建Python软链接
RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /workspace

# 复制依赖文件
COPY requirements.txt ./
COPY backend/requirements.txt ./backend/
COPY frontend/web/package*.json ./frontend/web/

# 安装Python依赖（包括增强转换所需的包）
RUN pip install --no-cache-dir --break-system-packages \
    -r requirements.txt \
    PyMuPDF==1.23.8 \
    pdfplumber==0.10.0 \
    pytesseract==0.3.10 \
    Pillow==10.0.0

# 如果backend有单独的requirements.txt，也安装
RUN if [ -f backend/requirements.txt ]; then \
        pip install --no-cache-dir --break-system-packages -r backend/requirements.txt; \
    fi

# 安装Node.js依赖
RUN cd frontend/web && npm install

# 安装Calibre（使用pip，因为Alpine仓库中没有）
# 注意: Calibre在Alpine上可能有兼容性问题，这里作为可选依赖
RUN pip install --no-cache-dir --break-system-packages calibre || \
    echo "Warning: Calibre installation failed, fallback mechanism will not be available"

# 创建必要目录
RUN mkdir -p uploads outputs config logs

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    ENHANCED_PDF_CONVERSION=false \
    CONVERSION_QUALITY_LEVEL=standard \
    OCR_CONFIDENCE_THRESHOLD=85 \
    ENABLE_CALIBRE_FALLBACK=true

# 暴露端口
EXPOSE 8000 3000

# 保持容器运行
CMD ["tail", "-f", "/dev/null"]
